# ============================================================
# NLG ARCADE HUB — BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.
#
# The server refuses to start if any variable marked REQUIRED
# is missing. There are no fallback defaults by design.
# ============================================================

# ── Server ──
# Render sets PORT itself; locally it defaults to 5000.
PORT=5000
NODE_ENV=development

# ── Database — REQUIRED ──
# Neon → your project → Connect → Connection string (URI).
# Keep the ?sslmode=require that Neon includes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ── Auth — REQUIRED ──
# Signs admin and customer session tokens. Use a long random
# string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=replace_with_a_long_random_string

# ── Image storage (ImageKit) — REQUIRED ──
# ImageKit dashboard → Developer options → API keys.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Publishing — optional ──
# Vercel → frontend project → Settings → Git → Deploy Hooks → Create Hook.
# The admin's "Publish to Google" button calls this to rebuild the site so
# pre-rendered pages pick up new games. Leave empty to hide the feature.
VERCEL_DEPLOY_HOOK_URL=

# ── CORS — optional ──
# Comma-separated list of front-end origins allowed to call this API.
# Leave empty to allow any origin (development only).
ALLOWED_ORIGINS=https://nlgarcadesforevents.vercel.app,https://nlg-arcade-admin.vercel.app

# ============================================================
# Admin accounts are NOT configured here.
# They are rows in the users table, created with:
#     node scripts/create-admin.js
# ============================================================
